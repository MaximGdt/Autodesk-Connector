{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(dotnet --info)",
      "Bash(dotnet --list-sdks)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet run --project src/AutocadMcp.Server -- --smoke)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git tag:*)",
      "Bash(git branch:*)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-env.ps1)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git restore:*)",
      "Bash(git revert:*)",
      "Bash(git stash:*)",
      "Bash(winget install:*)",
      "Bash(dotnet publish:*)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1:*)",
      "Bash(npx:*)",
      "Bash(npm:*)",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git clean:*)",
      "Bash(git config:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch --delete:*)",
      "Bash(git branch -f:*)",
      "Bash(git branch --force:*)",
      "Bash(git tag -d:*)",
      "Bash(git tag --delete:*)",
      "Bash(git tag -f:*)",
      "Bash(git tag --force:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -r:*)",
      "Bash(rmdir:*)",
      "Bash(del:*)",
      "Bash(rd:*)",
      "Bash(Remove-Item:*)",
      "Bash(format:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(Invoke-WebRequest:*)",
      "Bash(Invoke-RestMethod:*)",
      "Bash(iwr:*)",
      "Bash(irm:*)",
      "Bash(Set-ExecutionPolicy:*)",
      "Bash(reg:*)",
      "Bash(regedit:*)",
      "Bash(dotnet add:*)",
      "Bash(dotnet nuget:*)",
      "Edit(./docs/SECURITY.md)",
      "Edit(./tests/AutocadMcp.SecurityTests/**)",
      "Edit(./.claude/settings.json)",
      "Edit(./.github/**)",
      "Edit(./Directory.Packages.props)",
      "Edit(./Directory.Build.props)",
      "Edit(./global.json)",
      "Read(./**/.env)"
    ]
  }
}
